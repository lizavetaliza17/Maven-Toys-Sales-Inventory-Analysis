      <column caption='Revenue' datatype='real' name='[Calculation_0130063037034497]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Units] * FLOAT(REPLACE([Product_Price], &quot;$&quot;, &quot;&quot;))' />
      </column>
      <column caption='Cost' datatype='real' name='[Calculation_0130063039369221]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Units] * FLOAT(TRIM(REPLACE([Product_Cost], &quot;$&quot;, &quot;&quot;)))' />
      </column>
      <column caption='Profit' datatype='real' default-format='c#,##0.00&quot;$&quot;;-#,##0.00&quot;$&quot;' name='[Calculation_0130063039434758]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0130063037034497] - [Calculation_0130063039369221]' />
      </column>
      <column caption='Profit Margin' datatype='real' default-format='p0.00%' name='[Calculation_0130063039774727]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0130063039434758]) / SUM([Calculation_0130063037034497])' />
      </column>
      <column caption='Inventory Cost' datatype='real' name='[Calculation_0130063039852552]' role='measure' type='quantitative'>
